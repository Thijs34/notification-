# Generate a key pair with:  npm run vapid   (writes .env.local)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact URL. Apple rejects localhost URLs here.
VAPID_SUBJECT=mailto:you@example.com

# Optional but recommended: password required on the "Send" (PC) tab.
ADMIN_PASSWORD=

# Added automatically when you connect an Upstash Redis database to the
# project in the Vercel dashboard (Storage tab). Needed for PC -> phone sending.
KV_REST_API_URL=
KV_REST_API_TOKEN=
